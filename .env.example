# =============================================================================
# FINGuard environment configuration
#
# Copy to .env and fill in. NEVER commit .env — it is gitignored.
#   cp .env.example .env
# =============================================================================

# ---- runtime ----------------------------------------------------------------
ENVIRONMENT=development            # development | staging | production | test
DEBUG=true
PLATFORM_MODE=demo                 # demo (synthetic data) | production
CURRENCY=INR

# ---- database ---------------------------------------------------------------
# Local default is SQLite (no service required). PostgreSQL is mandatory in
# production; the app refuses to boot in production mode on SQLite.
# DATABASE_URL=sqlite:///./finguard.db
DATABASE_URL=postgresql+psycopg2://finguard:finguard@localhost:5432/finguard
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---- cache ------------------------------------------------------------------
# Leave blank to use the in-process cache (development only).
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL=30

# ---- streaming --------------------------------------------------------------
# Leave blank to use the in-process event bus (same semantics, single node).
KAFKA_BROKERS=
# KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=finguard
KAFKA_CONSUMER_GROUP=finguard-workers
EVENT_MAX_RETRIES=3
EVENT_RETRY_BACKOFF_MS=200

# ---- security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-64-character-random-string-before-any-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_MIN_LENGTH=10
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_AUTH_PER_MINUTE=20
MASK_PII=true

# ---- machine learning -------------------------------------------------------
MODEL_DIR=./artifacts/models
# Leave MLFLOW_TRACKING_URI blank to keep the registry table authoritative only.
MLFLOW_TRACKING_URI=
# MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=finguard-fraud
DRIFT_PSI_WARNING=0.10
DRIFT_PSI_CRITICAL=0.25

# ---- decision policy --------------------------------------------------------
DECISION_APPROVE_BELOW=30
DECISION_STEPUP_BELOW=70
DECISION_REVIEW_BELOW=85
COST_FALSE_NEGATIVE=50000
COST_FALSE_POSITIVE=500
COST_MANUAL_REVIEW=150

# ---- AI ---------------------------------------------------------------------
# none -> deterministic templates over retrieved evidence (fully functional).
# openai works with any OpenAI-compatible endpoint, including local servers.
LLM_PROVIDER=none                  # none | openai | anthropic
LLM_API_KEY=
LLM_BASE_URL=                      # e.g. http://localhost:11434/v1 for Ollama
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1200
AI_SQL_ROW_LIMIT=500

# ---- graph database (optional) ----------------------------------------------
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---- object storage (optional) ----------------------------------------------
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=finguard

# ---- demo data generation ---------------------------------------------------
SEED_CUSTOMERS=900
SEED_MERCHANTS=140
SEED_TRANSACTIONS=24000
SEED_FRAUD_RATE=0.011
SEED_RANDOM_STATE=20260824

# ---- frontend ---------------------------------------------------------------
# Only VITE_-prefixed variables reach the browser bundle. Never put a secret here.
VITE_API_URL=/api/v1
